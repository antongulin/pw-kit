import { Page, Locator, expect } from '@playwright/test';

/**
 * BasePage — universal foundation for all page objects.
 *
 * Contains everything that appears on every page regardless of page type:
 * app frame controls, modal helpers, common form fields, date helpers,
 * dropdown helpers, loading-state waits, and relative-year variables.
 *
 * Concrete pages extend this class (directly or via BaseGridPage / BaseEditPage).
 */
export class BasePage {
  readonly page: Page;

  // ─── Environment-backed constants ────────────────────────────────────────
  readonly BASE_URL = process.env.BASE_URL ?? '';
  readonly culture = process.env.CULTURE ?? 'en-US';

  // ─── App frame ───────────────────────────────────────────────────────────
  readonly userMenuButton: Locator;
  readonly logoutButton: Locator;
  readonly pageHeader: Locator;
  readonly loadingIndicator: Locator;

  // ─── Common action buttons ───────────────────────────────────────────────
  readonly saveButton: Locator;
  readonly saveAndCloseButton: Locator;
  readonly cancelButton: Locator;
  readonly deleteButton: Locator;
  readonly duplicateButton: Locator;
  readonly backButton: Locator;
  readonly addNewButton: Locator;

  // ─── Modal locators (scoped inside [role="dialog"]) ──────────────────────
  readonly modalDialog: Locator;
  readonly modalConfirmButton: Locator;
  readonly modalCancelButton: Locator;
  readonly modalYesButton: Locator;
  readonly modalNoButton: Locator;
  readonly modalDeleteButton: Locator;
  readonly modalCloseButton: Locator;

  // ─── Grid dynamic locators (use gridPrefix) ──────────────────────────────
  /** Set by subclasses via super(page, gridPrefix). Default 'grid' covers generic case. */
  readonly gridPrefix: string;
  readonly gridRowLocator: (id: string) => Locator;
  readonly gridDetailsButtonLocator: (id: string) => Locator;
  readonly gridDeleteButtonLocator: (id: string) => Locator;
  readonly gridDuplicateButtonLocator: (id: string) => Locator;
  readonly gridCheckboxLocator: (id: string) => Locator;

  // ─── Relative-year strings (populated by initialize()) ───────────────────
  thisYear = '';
  lastYear = '';
  yearBeforeLast = '';
  nextYear = '';
  twoYearsHence = '';

  constructor(page: Page, gridPrefix: string = 'grid') {
    this.page = page;
    this.gridPrefix = gridPrefix;

    // App frame
    this.userMenuButton = page.getByTestId('user-menu-button');
    this.logoutButton = page.getByTestId('logout-button');
    this.pageHeader = page.getByTestId('page-header');
    this.loadingIndicator = page.locator('.loading-indicator, [data-loading="true"]');

    // Common actions
    this.saveButton = page.getByTestId('save-button');
    this.saveAndCloseButton = page.getByTestId('save-and-close-button');
    this.cancelButton = page.getByTestId('cancel-button');
    this.deleteButton = page.getByTestId('delete-button');
    this.duplicateButton = page.getByTestId('duplicate-button');
    this.backButton = page.getByTestId('back-button');
    this.addNewButton = page.getByTestId('add-new-button');

    // Modal (scoped)
    this.modalDialog = page.getByRole('dialog');
    this.modalConfirmButton = this.modalDialog.getByRole('button', { name: 'Confirm' });
    this.modalCancelButton = this.modalDialog.getByRole('button', { name: 'Cancel' });
    this.modalYesButton = this.modalDialog.getByRole('button', { name: 'Yes' });
    this.modalNoButton = this.modalDialog.getByRole('button', { name: 'No' });
    this.modalDeleteButton = this.modalDialog.getByRole('button', { name: 'Delete' });
    this.modalCloseButton = this.modalDialog.getByRole('button', { name: 'Close' });

    // Grid dynamic locators
    this.gridRowLocator = (id: string) => page.getByTestId(`${gridPrefix}-row-${id}`);
    this.gridDetailsButtonLocator = (id: string) => page.getByTestId(`${gridPrefix}-detailsBtn-${id}`);
    this.gridDeleteButtonLocator = (id: string) => page.getByTestId(`${gridPrefix}-deleteBtn-${id}`);
    this.gridDuplicateButtonLocator = (id: string) => page.getByTestId(`${gridPrefix}-duplicateBtn-${id}`);
    this.gridCheckboxLocator = (id: string) => page.getByTestId(`${gridPrefix}-rowCheckbox-${id}`);
  }

  // ─── Lifecycle ───────────────────────────────────────────────────────────
  /** Call in beforeEach to populate relative-year string properties. */
  initialize(): void {
    const y = new Date().getFullYear();
    this.thisYear = String(y);
    this.lastYear = String(y - 1);
    this.yearBeforeLast = String(y - 2);
    this.nextYear = String(y + 1);
    this.twoYearsHence = String(y + 2);
  }

  // ─── Dates ───────────────────────────────────────────────────────────────
  /**
   * Canonical date input method. Use this for ALL date pickers — never .fill() or .pressSequentially() directly.
   * Accepts digits-only MMDDYYYY format (e.g. '03152024'). Uses pressSequentially with 50ms delay
   * so the picker's input mask formats as it goes.
   */
  async typeDateValue(dateLocator: Locator, dateString: string): Promise<void> {
    await dateLocator.click();
    await dateLocator.fill('');
    await dateLocator.pressSequentially(dateString, { delay: 50 });
  }

  /** Convert 'YYYYMMDD' to locale-formatted string (e.g. en-US → '03/15/2024'). */
  formatDateByLocale(yyyymmdd: string): string {
    const y = +yyyymmdd.slice(0, 4);
    const m = +yyyymmdd.slice(4, 6) - 1;
    const d = +yyyymmdd.slice(6, 8);
    return new Intl.DateTimeFormat(this.culture, {
      year: 'numeric', month: '2-digit', day: '2-digit'
    }).format(new Date(y, m, d));
  }

  // ─── Forms ───────────────────────────────────────────────────────────────
  /**
   * Idempotent toggle — reads aria-checked, only clicks if the state needs to change.
   * Prevents accidental double-toggles when switch is already in the desired state.
   */
  async toggleSwitch(toBeEnabled: boolean, locator: Locator): Promise<void> {
    const current = (await locator.getAttribute('aria-checked')) === 'true';
    if (current !== toBeEnabled) await locator.click();
  }

  /**
   * Open a single-select dropdown, scroll to the matching option, click it, press Tab to confirm.
   * Works across most custom dropdown component libraries.
   */
  async filterSingleSelect(dropdown: Locator, optionText: string): Promise<void> {
    await dropdown.click();
    const option = this.page.getByRole('option', { name: optionText });
    await option.scrollIntoViewIfNeeded();
    await option.click();
    await this.page.keyboard.press('Tab');
  }

  // ─── Random data helpers ─────────────────────────────────────────────────
  getRandomEmail(): string {
    return `user${Math.floor(Math.random() * 9999999)}@test.com`;
  }

  getRandomString(length = 8): string {
    return Math.random().toString(36).substring(2, 2 + length);
  }

  coinFlip(): boolean {
    return Math.random() < 0.5;
  }

  // ─── Loading / waiting ───────────────────────────────────────────────────
  /**
   * Wait for known loading indicators to disappear.
   * Order: domcontentloaded → loading-indicator selectors → 100ms buffer for animations.
   */
  async waitForSpinnerToDisappear(): Promise<void> {
    await this.page.waitForLoadState('domcontentloaded');
    await expect(this.loadingIndicator).toHaveCount(0, { timeout: 10_000 }).catch(() => {});
    await this.page.waitForTimeout(100); // small buffer for CSS transitions
  }

  // ─── Notifications ───────────────────────────────────────────────────────
  /** Assert a success notification appears and return its text. */
  async verifySuccess(): Promise<string> {
    const toast = this.page.getByRole('status').filter({ hasText: /saved|created|updated|deleted/i });
    await expect(toast).toBeVisible();
    return (await toast.textContent()) ?? '';
  }
}
